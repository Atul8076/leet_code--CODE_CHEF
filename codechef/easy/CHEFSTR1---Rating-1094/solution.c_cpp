#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i = 0 ; i<n ; i++){
        cin>>v[i];
    }
    int sum = 0; 
    int i = 0 , j = i+1;
    while(i<=n-2){
       sum += abs(v[j]-v[i]) -1;
       i++;
       j++;
    }
    cout<<sum<<endl;
}
}
