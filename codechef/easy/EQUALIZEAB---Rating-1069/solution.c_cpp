#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int a,b,x;
    cin>>a>>b>>x;
    int c = abs(a-b);
    if(a == b){
        cout<<"YES"<<endl;
    }
    else{
        if(c%2*x== 0){
            cout<<"YES"<<endl;
        }
        else{
            cout<<"NO"<<endl;
        }
    }
    
}

}
