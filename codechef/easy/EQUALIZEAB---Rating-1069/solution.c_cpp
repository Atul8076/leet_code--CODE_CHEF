#include <iostream>
#include <cmath>

using namespace std;

void solve() {
    long long A, B, X;
    cin >> A >> B >> X;

    long long diff = abs(A - B);

   
    if (diff % (2 * X) == 0) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}