#include <iostream>
using namespace std;

void solve() {
    int A, B;
    cin >> A >> B;
    
    int limak = 0, bob = 0;
    int turn = 1;
    
    while (true) {
        if (turn % 2 != 0) {
            // Limak's turn (1, 3, 5...)
            if (limak + turn > A) {
                cout << "Bob\n";
                break;
            }
            limak += turn;
        } else {
            // Bob's turn (2, 4, 6...)
            if (bob + turn > B) {
                cout << "Limak\n";
                break;
            }
            bob += turn;
        }
        turn++;
    }
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}