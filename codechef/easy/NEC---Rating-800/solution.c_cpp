#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int n,k;
    cin>>n>>k;
    int arr[n];
    queue<int>st;
    for(int i = 0; i<n; i++){
        cin>>arr[i];
        st.push(arr[i]);
    }
    for(int i = 0; i<n; i++){
        
        st.push(arr[i]);
    }
    for(int i = 1; i<=k; i++){
        st.push(st.front());
        st.pop();
    }
    for(int i = 0 ; i<st.size(); i++){
        cout<<st.front()<<" ";
        st.pop();
    }
    cout<<endl;
    
}
