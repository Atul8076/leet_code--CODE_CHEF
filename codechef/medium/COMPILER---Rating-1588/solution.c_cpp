#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;

while(t--){
    string s;
    cin>>s;
    stack<char>st;
    int m = 0;
    for (int i = 0; i<s.length(); i++){
        if(s[i] == '<'){
            st.push(s[i]);
        }
        else{
            if(st.empty()){
                break;
            }
            else{
                st.pop();
                if(st.empty()){
                    m = i+1;
                }
            }
        }
    }
    cout<<m<<endl;
}

}
