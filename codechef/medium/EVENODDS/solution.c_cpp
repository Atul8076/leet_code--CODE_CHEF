#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int n ;
    cin>>n;
    vector<int>v(n);
    for(int i = 0 ; i<n; i++){
        cin>>v[i];
    }
    
    int count = 0 ; 
    int d = 0 ;
    for(int i = 0 ; i<n ; i++){
        if(v[i]%2 == 0){
            count++;
            
        }
        else{
            d = max(d,count);
            count = 0 ; 
        }
    }
    int e = max(count,d);
    cout<<e<<endl;
    
}
}
